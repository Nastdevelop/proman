
generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int      @id @default(autoincrement())
  name     String   @unique
  password String

  rooms    Room[]
  members  Member[]
}

model Room {
  id         String   @id @default(cuid())
  pmId       Int
  judul      String
  jenis      Jenis    @default(PERSONAL)
  shareToken String?  @unique

  pm        User        @relation(fields: [pmId], references: [id])
  members   Member[]
  tasks     Task[]      @relation("RoomTasks")
  divisions Division[]
}

enum Jenis {
  PERSONAL
  TEAM
  FREELANCE
}

enum Taskstatus {
  DEFAULT
  PROGRESS
  PENDING
  DONE
}

model Task {
  id         Int        @id @default(autoincrement())
  roomId     String?
  divisionId String?
  title      String
  content    String     @default("")
  status     Taskstatus @default(DEFAULT)
  prioritas  Int        @default(2)
  createdAt  DateTime   @default(now())

  room      Room?     @relation("RoomTasks", fields: [roomId], references: [id])
  division  Division? @relation(fields: [divisionId], references: [id])
}

model Division {
  id     String @id @default(cuid())
  roomId String
  name   String

  room  Room   @relation(fields: [roomId], references: [id])
  tasks Task[]
}

model Member {
  id     Int    @id @default(autoincrement())
  roomId String
  userId Int

  room Room @relation(fields: [roomId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([roomId, userId])
}
